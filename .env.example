# ResearchPilot AI - Environment Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# Google Gemini LLM (Primary)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Groq LLM (Fallback)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# Tavily Search
TAVILY_API_KEY=

# Firecrawl Web Extraction (optional - falls back to httpx+BeautifulSoup)
FIRECRAWL_API_KEY=

# Qdrant Vector Database
QDRANT_URL=
QDRANT_API_KEY=

# Mock Mode - set to true for development/testing without API calls
MOCK_MODE=false
